{
  "name": "@vp-search/core",
  "version": "0.1.0",
  "description": "Pluggable search for VitePress — an accessible search dialog, a shared result format, and a provider contract any backend can implement.",
  "keywords": [
    "documentation",
    "search",
    "site-search",
    "vitepress",
    "vitepress-plugin",
    "vue"
  ],
  "license": "MIT",
  "author": "Divyansh Singh <brc-dd@hotmail.com> (https://github.com/brc-dd)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brc-dd/vp-search.git",
    "directory": "packages/core"
  },
  "funding": "https://github.com/sponsors/brc-dd",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.vue"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./client/*": "./src/client/*",
    "./node": "./src/node/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./client/*": "./dist/client/*",
      "./node": "./dist/node/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.shared.json && vue-tsc -p tsconfig.client.json && tsc -p tsconfig.node.json && vue-tsc -p test"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0"
  },
  "devDependencies": {
    "@volar/typescript": "^2.4.28",
    "@vue/language-core": "^3.3.10",
    "rolldown": "^1.2.5",
    "vite": "^8.2.1",
    "vitepress": "2.0.0-alpha.19",
    "vue": "^3.5.41",
    "vue-sfc-transformer": "^0.2.5"
  },
  "peerDependencies": {
    "vitepress": "^2.0.0-alpha.1",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    }
  }
}

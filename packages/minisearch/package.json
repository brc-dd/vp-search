{
  "name": "@vp-search/minisearch",
  "version": "0.1.0",
  "description": "Local search provider for @vp-search/core — per-locale MiniSearch indexes built from the rendered site, tiered artifacts queried in a Web Worker, CJK-aware.",
  "keywords": [
    "full-text-search",
    "local-search",
    "minisearch",
    "search",
    "vitepress",
    "vitepress-plugin",
    "web-worker"
  ],
  "license": "MIT",
  "author": "Divyansh Singh <brc-dd@hotmail.com> (https://github.com/brc-dd)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brc-dd/vp-search.git",
    "directory": "packages/minisearch"
  },
  "funding": "https://github.com/sponsors/brc-dd",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/worker.*"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./adapter": "./src/adapter.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./adapter": "./dist/adapter.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.shared.json && tsc -p tsconfig.client.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p test"
  },
  "dependencies": {
    "linkedom": "^0.18.13",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@vp-search/core": "workspace:*",
    "vitepress": "2.0.0-alpha.19"
  },
  "peerDependencies": {
    "@vp-search/core": "workspace:*",
    "vitepress": "^2.0.0-alpha.1"
  }
}

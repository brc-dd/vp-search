{
  "name": "@vp-search/algolia",
  "version": "0.1.1",
  "description": "Algolia DocSearch provider for @vp-search/core — a plain-fetch adapter for DocSearch indexes, without the algoliasearch client or the DocSearch UI bundle.",
  "keywords": [
    "algolia",
    "docsearch",
    "search",
    "vitepress",
    "vitepress-plugin"
  ],
  "license": "MIT",
  "author": "Divyansh Singh <brc-dd@hotmail.com> (https://github.com/brc-dd)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brc-dd/vp-search.git",
    "directory": "packages/algolia"
  },
  "funding": "https://github.com/sponsors/brc-dd",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./adapter": "./src/adapter.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./adapter": "./dist/adapter.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.client.json && tsc -p test"
  },
  "devDependencies": {
    "@vp-search/core": "workspace:*"
  },
  "peerDependencies": {
    "@vp-search/core": "workspace:*"
  }
}

{
  "name": "vp-search",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Backend-agnostic search for VitePress — one accessible UI, swappable search providers.",
  "license": "MIT",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.7.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0-rc.7",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "typecheck": "tsc -p . && pnpm --filter \"./packages/*\" typecheck",
    "format": "prettier --experimental-cli --write .",
    "format:check": "prettier --experimental-cli --check .",
    "docs:dev": "pnpm -C examples/docs dev",
    "docs:build": "pnpm -C examples/docs build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.6.0",
    "vue-tsc": "^3.3.10"
  }
}
